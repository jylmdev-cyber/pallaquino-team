{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uasek:engineering-extension:1",
  "title": "Engineering Intelligence Platform extension API v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "kind", "version", "permissions", "dependencies", "capabilities", "entrypoint"],
  "properties": {
    "api_version": {"const": 1, "type": "integer"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "not": {"const": "python"}},
    "kind": {"enum": ["agent", "skill", "provider", "tool", "connector"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "entrypoint": {"type": "string"}
  }
}
